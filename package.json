{
  "name": "@data-wise/atlas",
  "version": "0.13.1",
  "description": "Project state engine - registry, sessions, capture, and context management for ADHD-friendly workflow",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "atlas": "./bin/atlas.js",
    "atlas-mcp": "./src/mcp/index.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "completions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:debug": "npm test -- --detectOpenHandles --runInBand",
    "test:unit": "npm test -- --testPathPattern=test/unit",
    "test:integration": "npm test -- --testPathPattern=test/integration",
    "test:e2e": "npm test -- --testPathPattern=test/e2e",
    "test:coverage": "npm test -- --coverage",
    "test:dogfood": "bash test/dogfood.sh",
    "test:dogfood-auto": "bash test/dogfood-comprehensive.sh",
    "test:dogfood-log": "bash test/dogfood-comprehensive.sh --log",
    "test:dogfood-ui": "bash test/dogfood-interactive-v2.sh",
    "test:dashboard": "bash test/interactive-dashboard-test.sh",
    "test:cli": "bash tests/cli/automated-tests.sh",
    "test:cli-ui": "bash tests/cli/interactive-tests.sh",
    "test:ink": "npm test -- --testPathPattern=test/.*dashboard-ink",
    "test:ink:unit": "npm test -- --testPathPattern=test/unit/.*dashboard-ink",
    "test:ink:e2e": "npm test -- --testPathPattern=test/e2e/dashboard-ink",
    "test:ink:e2e:vitest": "npx vitest run --config vitest.config.e2e.ts",
    "test:playwright": "npx playwright test --config playwright.config.ts",
    "test:playwright:install": "npx playwright install chromium",
    "test:ink:dogfood": "bash test/dogfood/dashboard-ink/basic-functionality.sh",
    "test:ink:dogfood:analytics": "bash test/dogfood/dashboard-ink/analytics-dogfood.sh",
    "test:ink:all": "npm run test:ink && npm run test:ink:dogfood",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint src/ test/",
    "format": "prettier --write 'src/**/*.js' 'test/**/*.js'",
    "start": "node bin/atlas.js",
    "prepublishOnly": "npm test",
    "release:version": "npm version --no-git-tag-version",
    "release:tag": "git tag -a v$npm_package_version -m \"Release v$npm_package_version\"",
    "release:push": "git push origin main --follow-tags",
    "release:github": "gh release create v$npm_package_version --generate-notes"
  },
  "keywords": [
    "project-management",
    "workflow",
    "adhd",
    "productivity",
    "cli",
    "state-management",
    "context-switching",
    "session-tracking"
  ],
  "author": "Stat-Wise",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Data-Wise/atlas.git"
  },
  "bugs": {
    "url": "https://github.com/Data-Wise/atlas/issues"
  },
  "homepage": "https://github.com/Data-Wise/atlas#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "glob": "^10.3.10",
    "ink": "^6.6.0",
    "open": "^11.0.0",
    "react": "^19.2.3",
    "ws": "^8.18.3",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@playwright/test": "^1.61.1",
    "@swc/core": "^1.15.11",
    "@swc/jest": "^0.2.39",
    "@types/react": "^19.2.7",
    "eslint": "^8.57.1",
    "express": "^5.2.1",
    "globals": "^13.24.0",
    "ink-testing-library": "^4.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "vitest": "^4.1.9"
  }
}
